<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sundex-style-ls</ToolCommandName>
    <Description>Live checks for Sundex .snx.ss stylesheets: a language server for Rider and VS Code, and `--check` for CI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Components, for the settings an element can take; it brings the parser with it. -->
    <ProjectReference Include="..\Sundex.Components\Sundex.Components.csproj"/>
  </ItemGroup>

</Project>
