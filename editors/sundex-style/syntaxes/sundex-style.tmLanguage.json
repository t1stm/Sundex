{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sundex Style",
  "scopeName": "source.sundex-style",
  "fileTypes": ["snx.ss"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#block" },
    { "include": "#declaration" },
    { "include": "#import" },
    { "include": "#selector" },
    { "include": "#property" },
    { "include": "#value" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.sundex-style",
      "match": "//.*$"
    },
    "block": {
      "match": "^\\s*(@?(?:animation|component|class|id))\\s+([A-Za-z0-9_-]+)",
      "captures": {
        "1": { "name": "keyword.other.block.sundex-style" },
        "2": { "name": "entity.name.type.sundex-style" }
      }
    },
    "declaration": {
      "match": "\\b(var)\\s+([A-Za-z_][\\w-]*)",
      "captures": {
        "1": { "name": "storage.type.var.sundex-style" },
        "2": { "name": "variable.other.definition.sundex-style" }
      }
    },
    "import": {
      "match": "\\b(import|as)\\b",
      "name": "keyword.control.import.sundex-style"
    },
    "selector": {
      "match": "\\b(state|media)(\\[)([^\\]]*)(\\])",
      "captures": {
        "1": { "name": "keyword.other.selector.sundex-style" },
        "2": { "name": "punctuation.section.brackets.begin.sundex-style" },
        "3": { "name": "variable.parameter.sundex-style" },
        "4": { "name": "punctuation.section.brackets.end.sundex-style" }
      }
    },
    "property": {
      "match": "(?<![\\w$.-])([A-Za-z][\\w-]*)(?=\\s*=)",
      "name": "support.type.property-name.sundex-style"
    },
    "value": {
      "patterns": [
        {
          "name": "string.quoted.double.sundex-style",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.sundex-style", "match": "\\\\." }]
        },
        { "name": "constant.other.color.sundex-style", "match": "#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?\\b" },
        { "name": "storage.modifier.keyword.sundex-style", "match": "![a-z-]+" },
        { "name": "variable.other.sundex-style", "match": "\\$[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)?" },
        { "name": "support.function.sundex-style", "match": "\\bvec[234](?=\\s*\\()" },
        {
          "match": "(-?\\d+(?:\\.\\d+)?)(px|ms|s|deg|%)?",
          "captures": {
            "1": { "name": "constant.numeric.sundex-style" },
            "2": { "name": "keyword.other.unit.sundex-style" }
          }
        },
        { "name": "keyword.operator.assignment.sundex-style", "match": "=" },
        { "name": "punctuation.separator.sundex-style", "match": "[;,]" }
      ]
    }
  }
}
