<Project>
  <PropertyGroup>
    <SundexBrowserAudioSource>$(MSBuildThisFileDirectory)browser/sundex_audio.c</SundexBrowserAudioSource>
    <SundexBrowserAudioSource Condition="!Exists('$(SundexBrowserAudioSource)')">$(MSBuildThisFileDirectory)../Audio/Native/sundex_audio.c</SundexBrowserAudioSource>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(RootNamespace)' != ''">
      <_Parameter1>SundexAssetRoot</_Parameter1>
      <_Parameter2>$(RootNamespace)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SundexSourceRoot</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
    <RuntimeHostConfigurationOption Include="Sundex.Development" Value="true"/>
  </ItemGroup>
  <!-- OpenTK 5 pre.16 probes libglfw.so.3, but its 3.5 redist ships only libglfw.so.3.5. -->
  <Target Name="SundexAddGlfwSoname" AfterTargets="ResolvePackageAssets"
          Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe'">
    <ItemGroup>
      <_SundexGlfw Include="@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)"
                   Condition="'%(Filename)%(Extension)' == 'libglfw.so.3.5'"/>
      <ContentWithTargetPath Include="@(_SundexGlfw)"
                             TargetPath="%(_SundexGlfw.DestinationSubDirectory)libglfw.so.3"
                             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
  </Target>
</Project>
