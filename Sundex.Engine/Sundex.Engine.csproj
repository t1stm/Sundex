<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13"/>
    <PackageReference Include="OpenTK" Version="5.0.0-pre.16"/>
    <PackageReference Include="OpenTK.redist.glfw" Version="3.5.1.71"/>
    <PackageReference Include="Serilog" Version="4.4.0"/>
    <PackageReference Include="Serilog.Expressions" Version="5.0.0"/>
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0"/>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundex.Slug\Sundex.Slug.csproj"/>
    <ProjectReference Include="..\Sundex.Reactive\Sundex.Reactive.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Lato-Bold.ttf"/>
    <EmbeddedResource Include="Assets\Fonts\Lato-Regular.ttf"/>
    <EmbeddedResource Include="Assets\Fonts\lucide.ttf"/>
    <EmbeddedResource Include="Assets\Fonts\README.md"/>
    <None Update="Assets/Fonts/LICENSE-*.txt" Pack="true" PackagePath="licenses/%(Filename)%(Extension)"/>
    <None Update="buildTransitive/Sundex.Engine.props" Pack="true" PackagePath="buildTransitive/Sundex.Engine.props"/>
    <EmbeddedResource Include="Assets\Shaders\Text\Batched.frag"/>
    <EmbeddedResource Include="Assets\Shaders\Text\Batched.vert"/>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sundex.Components.Tests"/>
    <InternalsVisibleTo Include="Sundex.Engine.Tests"/>
  </ItemGroup>

  <!--
    The native audio library: miniaudio and the sundex_audio shim, one build per RID under
    Audio/Native/runtimes (built by build/audio-native.sh, not committed). The package ships them as
    runtime assets; project references get them copied to runtimes/<rid>/native next to the app,
    where the engine's DllImport resolver looks.
  -->
  <PropertyGroup>
    <SundexAudioNative>$(MSBuildThisFileDirectory)Audio/Native/</SundexAudioNative>
    <_SundexHostOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_SundexHostOs>
    <_SundexHostOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_SundexHostOs>
    <_SundexHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_SundexHostArch>
    <_SundexAudioLibrary Condition="'$(_SundexHostOs)' == 'linux'">libsundex_audio.so</_SundexAudioLibrary>
    <_SundexAudioLibrary Condition="'$(_SundexHostOs)' == 'osx'">libsundex_audio.dylib</_SundexAudioLibrary>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Audio/Native/runtimes/**/*"/>
    <None Include="Audio/Native/runtimes/**/*" Pack="true" PackagePath="runtimes/"
          CopyToOutputDirectory="PreserveNewest" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <!--
    Builds the library for this machine when it's missing or stale, then re-reads the folder so a
    first build ships what it just made. Windows needs the library from CI.
  -->
  <Target Name="SundexBuildAudioNative" BeforeTargets="AssignTargetPaths"
          Condition="'$(_SundexHostOs)' != '' And '$(SundexSkipAudioNative)' != 'true'"
          Inputs="$(SundexAudioNative)sundex_audio.c;$(SundexAudioNative)miniaudio.h"
          Outputs="$(SundexAudioNative)runtimes/$(_SundexHostOs)-$(_SundexHostArch)/native/$(_SundexAudioLibrary)">
    <Exec Command="sh &quot;$(MSBuildThisFileDirectory)../build/audio-native.sh&quot; $(_SundexHostOs)-$(_SundexHostArch)"/>
    <ItemGroup>
      <_SundexAudioNative Include="Audio/Native/runtimes/**/*"/>
      <None Remove="@(_SundexAudioNative)"/>
      <None Include="@(_SundexAudioNative)" Pack="true"
            PackagePath="runtimes/"
            CopyToOutputDirectory="PreserveNewest"
            Link="runtimes/%(_SundexAudioNative.RecursiveDir)%(_SundexAudioNative.Filename)%(_SundexAudioNative.Extension)"/>
    </ItemGroup>
  </Target>

</Project>
